<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Minimal fallback theme used by the system before Compose inflates.
         Compose (EzmpvTheme) provides the real Material 3 + dynamic color theming. -->
    <style name="Theme.Ezmpv" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>